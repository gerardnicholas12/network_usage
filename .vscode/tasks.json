{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Network Usage dashboard",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "streamlit", "run", "network_usage.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Run Network Usage tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
